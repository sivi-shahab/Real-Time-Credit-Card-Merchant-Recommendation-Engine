KAFKA_BOOTSTRAP=localhost:29092
REDIS_URL=redis://localhost:56379/0
POSTGRES_DSN=postgresql://rec:rec@localhost:55432/rec
# Host scripts use the owner and migrate at start; the compose services use rec_app with
# DB_AUTO_MIGRATE=false (E-4, docs/runbooks.md#secrets-and-rotation)
DB_AUTO_MIGRATE=true
DATA_DIR=./data
ENVIRONMENT=local
ADMIN_TOKENS=admin-token:admin:Platform Operator,analyst-token:analyst:Analyst,ops-token:ops:Marketing Operator,auditor-token:auditor:Auditor,ml-token:mlops:ML Engineer,approver-token:approver:Approver,viewer-token:viewer:Viewer
RANKING_SERVICE_URL=http://localhost:8100
# D-5: shared by the API and the ranking service; required outside local/test/ci
RANKING_SERVICE_TOKEN=
MLFLOW_TRACKING_URI=sqlite:///./data/mlflow.db
MODEL_DIR=./data/models
# BFF (SDD 13.4). Plain-http local only; production keeps the Secure default.
COOKIE_SECURE=false
OIDC_DISCOVERY_URL=http://localhost:8180/realms/rec/.well-known/openid-configuration
OIDC_CLIENT_SECRET=local-dev-secret-change-me
OIDC_REDIRECT_URI=http://localhost:5173/bff/callback
# Customer channel (S-2, ADR-0013). All three empty = only the dev `cust-<id>` stand-in.
CUSTOMER_JWKS_URL=
CUSTOMER_JWT_ISSUER=
CUSTOMER_JWT_AUDIENCE=
CUSTOMER_ID_CLAIM=sub
# D-1: per customer per minute, across all API workers; 0 = unlimited
RATE_LIMIT_RECOMMENDATIONS_PER_MINUTE=60
RATE_LIMIT_FEEDBACK_PER_MINUTE=120

# Learning settings below are only a new deployment's starting values: once a change is
# approved on the dashboard (ADR-0011) the stored values win.
# Continuous learning, stage 1 (ADR-0007): retrain on live feedback. 0 = off.
AUTO_RETRAIN_INTERVAL_HOURS=0
AUTO_RETRAIN_MIN_NEW_IMPRESSIONS=500
AUTO_RETRAIN_KEEP_EXPORTS=3
# Continuous learning, stage 2 (ADR-0007): online bandit, shadow only. Never serves.
ONLINE_BANDIT_ENABLED=false
ONLINE_BANDIT_EXPLORATION=1.0
ONLINE_BANDIT_LEARN_INTERVAL_SECONDS=300
# Worker (ADR-0012): training queue and the scheduled uplift report (0 = off).
TRAINING_TIMEOUT_HOURS=6
UPLIFT_REPORT_INTERVAL_HOURS=24
# Promo uplift experiment (ADR-0010): % of customers served without promo offers. 0 = off.
PROMO_HOLDOUT_PERCENT=0
