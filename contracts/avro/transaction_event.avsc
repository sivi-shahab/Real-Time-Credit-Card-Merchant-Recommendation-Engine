{
  "type": "record",
  "name": "TransactionEvent",
  "namespace": "id.co.bank.rec.events",
  "doc": "EVT-001 envelope on cc.transactions (key: customerId). Money is integer minor units (6.1).",
  "fields": [
    {"name": "eventId", "type": {"type": "string", "logicalType": "uuid"}, "doc": "Idempotency key (EVT-003)."},
    {"name": "eventType", "type": "string", "doc": "Controlled vocabulary; currently transaction.created."},
    {"name": "eventVersion", "type": "string", "doc": "Semantic version of this contract."},
    {"name": "occurredAt", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "producedAt", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null},
    {"name": "producer", "type": "string"},
    {"name": "traceparent", "type": ["null", "string"], "default": null},
    {"name": "correlationId", "type": ["null", "string"], "default": null},
    {"name": "payload", "type": {
      "type": "record",
      "name": "TransactionPayload",
      "doc": "Typed payload. No PAN, CVV or cardholder name (SYN-002).",
      "fields": [
        {"name": "transactionId", "type": "string", "doc": "Business identity; second dedup key."},
        {"name": "customerId", "type": "string", "doc": "Pseudonymous customer id."},
        {"name": "merchantId", "type": "string"},
        {"name": "transactionType", "type": {"type": "enum", "name": "TransactionType", "symbols": ["PURCHASE", "REFUND", "REVERSAL"]}},
        {"name": "amountMinor", "type": "long", "doc": "Always > 0; the type decides the effect on net spend."},
        {"name": "currency", "type": {"type": "enum", "name": "Currency", "symbols": ["IDR"]}},
        {"name": "occurredAt", "type": {"type": "long", "logicalType": "timestamp-millis"}},
        {"name": "originalTransactionId", "type": ["null", "string"], "default": null, "doc": "Required for REFUND and REVERSAL."},
        {"name": "categoryCode", "type": ["null", "string"], "default": null},
        {"name": "cityCode", "type": ["null", "string"], "default": null},
        {"name": "channel", "type": ["null", {"type": "enum", "name": "Channel", "symbols": ["ONLINE", "OFFLINE"]}], "default": null}
      ]
    }}
  ]
}
