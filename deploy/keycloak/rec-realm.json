{
  "realm": "rec",
  "enabled": true,
  "ssoSessionIdleTimeout": 1800,
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12)",
  "roles": {
    "realm": [
      {
        "name": "Viewer"
      },
      {
        "name": "Analyst"
      },
      {
        "name": "Marketing Operator"
      },
      {
        "name": "ML Engineer"
      },
      {
        "name": "Platform Operator"
      },
      {
        "name": "Approver"
      },
      {
        "name": "Auditor"
      }
    ]
  },
  "clients": [
    {
      "clientId": "rec-dashboard",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-dev-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5173/bff/callback"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/login"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "rec-superset",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-dev-superset-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:8088/oauth-authorized/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8088"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8088/login/"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "userinfo.token.claim": "true",
            "id.token.claim": "false",
            "access.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@rec.local",
      "emailVerified": true,
      "firstName": "viewer",
      "lastName": "Demo",
      "credentials": [
        {
